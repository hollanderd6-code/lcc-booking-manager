<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ecran de lancement Boostinghost — identite « Maison Vert ».

  Le verrou (cartouche + BOOSTINGHOST + baseline) est une IMAGE et non du
  texte. Trois raisons :

    1. Le mot-symbole est en Marcellus et le B en Cormorant Garamond. Utiliser
       ces polices dans un storyboard imposerait de les embarquer dans le
       bundle et de les declarer dans Info.plist ; a la moindre omission, iOS
       retomberait silencieusement sur Helvetica.
    2. Une UILabel ne sait pas gerer l'approche (letter-spacing) sans passer
       par une chaine attribuee, illisible et fragile en XML.
    3. L'image provient du meme trace vectorise que le web, l'icone d'app et
       l'image de partage : le dessin est rigoureusement identique partout.

  L'image est fournie en 1x, 2x et 3x dans LaunchLogo.imageset. Sa largeur est
  contrainte a 62 % de la largeur d'ecran, plafonnee a 260 pt : elle respire
  sur un iPhone SE comme sur un iPad, sans jamais toucher les bords.

  Fond  : #0E3B2E (vert bouteille de la marque)
  Encre : #F2EADA (ivoire)
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21701" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21678"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>

                            <!-- Verrou complet : cartouche, mot-symbole et baseline -->
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="verrou">
                                <rect key="frame" x="74.5" y="358" width="244" height="142"/>
                            </imageView>

                        </subviews>

                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>

                        <!-- Vert bouteille #0E3B2E -->
                        <color key="backgroundColor" red="0.054901960784313725" green="0.23137254901960784" blue="0.18039215686274510" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>

                        <constraints>
                            <!-- Centre horizontalement -->
                            <constraint firstItem="verrou" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="verrou-centerX"/>

                            <!-- Legerement au-dessus du centre geometrique : un bloc
                                 pose exactement au milieu parait toujours trop bas -->
                            <constraint firstItem="verrou" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" constant="-24" id="verrou-centerY"/>

                            <!-- 62 % de la largeur d'ecran -->
                            <constraint firstItem="verrou" firstAttribute="width" secondItem="Ze5-6b-2t3" secondAttribute="width" multiplier="0.62" id="verrou-width"/>

                            <!-- Jamais plus de 260 pt, pour les iPad -->
                            <constraint firstItem="verrou" firstAttribute="width" relation="lessThanOrEqual" constant="260" id="verrou-width-max"/>

                            <!-- Rapport du trace conserve : 240 x 140 -->
                            <constraint firstItem="verrou" firstAttribute="height" secondItem="verrou" secondAttribute="width" multiplier="140:240" id="verrou-ratio"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchLogo" width="240" height="140"/>
    </resources>
</document>
