{
  "appId": "com.boostinghost.app",
  "appName": "Boostinghost",
  "webDir": "public",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0E3B2E",
      "showSpinner": false,
      "spinnerColor": "#F2EADA"
    },
    "StatusBar": {
      "style": "light",
      "backgroundColor": "#0E3B2E",
      "overlaysWebView": false
    },
    "Haptics": {
      "enabled": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "ios": {
    "backgroundColor": "#FBFBFA",
    "contentInset": "automatic"
  }
}